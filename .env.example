# 复制为 .env 后再改；docker compose 会自动读取。

# 访问密码（必填，不填则关闭登录门，只适合本机开发）
STUDIO_PASSWORD=change-me

# 构建用基础镜像；Docker Hub 不可达时换成可达的镜像源，例如：
# NODE_IMAGE=docker.m.daocloud.io/library/node:24-alpine
NODE_IMAGE=node:24-alpine

# 会话签名密钥（建议固定，否则每次重启所有人需要重新登录）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STUDIO_SECRET=

# 对外端口
STUDIO_PORT=8080

# 图片后端：stub | comfyui | ark
STUDIO_IMAGE_DRIVER=stub

# 本地 ComfyUI 地址（image driver 选 comfyui 时使用）
COMFYUI_URL=http://host.docker.internal:8188

# 火山方舟（image driver 选 ark 时使用）
ARK_API_KEY=
ARK_MODEL=doubao-seedream-4-0-250828

# 通过 HTTPS 对外服务时设为 1
STUDIO_SECURE_COOKIES=0
